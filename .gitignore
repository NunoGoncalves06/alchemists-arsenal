# =============================================================================
#  Alchemist's Arsenal — Unity .gitignore
#  Canonical template: https://github.com/github/gitignore/blob/main/Unity.gitignore
#
#  Rule of thumb:
#    COMMIT   Assets/ (incl. every *.meta), ProjectSettings/, Packages/manifest.json + packages-lock.json
#    IGNORE   everything the editor regenerates on open (Library, Temp, *.csproj, *.sln, Logs, builds)
# =============================================================================

# --- Unity editor-generated folders ------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures / recordings can get huge and may hold sensitive data
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Autogenerated Rider / JetBrains editor plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# --- IDE state (editors regenerate this; not shared config) ----------------
.vs/
.vscode/
.idea/
.gradle/
.consulo/
.builds/
.opencode/

# --- OS junk --------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Autogenerated solution / project files -------------------------------
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# meta files for the generated debug artefacts above (real Assets/*.meta stay committed)
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Unity crash / diagnostics ------------------------------------------
sysinfo.txt
crashlytics-build.properties

# --- Build outputs ----------------------------------------------------
*.apk
*.aab
*.app
*.ipa
*.exe
*.unitypackage
*.unitypackage.meta

# --- Addressables / StreamingAssets build artefacts -----------------
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# --- Installer build output ---------------------------------------
/installer/Output/

# --- Claude Code (share skills + project settings; keep local overrides out) ---
.claude/settings.local.json
.claude/projects/

# --- Large binary assets (uncomment per project need) ------------
# *.mp4
# *.mov
# *.wav
